// Apple Silicon only — no Rosetta / Intel support
ARCHS = arm64
EXCLUDED_ARCHS = x86_64

// Use ad-hoc signing by default (no Apple Developer account required).
// Maintainers with a Developer ID certificate can switch to CodeSigning.xcconfig.
#include "Configurations/CodeSigning-AdHoc.xcconfig"
